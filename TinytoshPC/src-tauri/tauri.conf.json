{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TinytoshPC",
  "version": "1.3.2",
  "identifier": "com.tinytosh.pc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
    {
      "title": "Tinytosh PC",
      "width": 600,
      "height": 800,
      "resizable": true,
      "fullscreen": false,
      "visible": false,
      "transparent": false
    }
  ],
  "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}